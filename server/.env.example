# Firebase Configuration (optional - server will run without Firebase)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id",...}
# GOOGLE_CLOUD_PROJECT=your-project-id
# WayFinder's own Firestore database (default: wayfinder)
# FIRESTORE_DATABASE=wayfinder

# Server Configuration
PORT=8080

# Allowed browser origin for the API (default: *)
# CORS_ORIGIN=https://your-app.web.app
