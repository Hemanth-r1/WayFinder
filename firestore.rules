rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function roleOf(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    // Profiles: users manage their own, but only admins (in the app, via the server) change
    // `role` or `disabled`. Users may ask for a promotion by setting `requestedRole`.
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.role == 'user'
        && !('disabled' in request.resource.data);
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.get('disabled', false) == resource.data.get('disabled', false);
      // Saved places (home, work, favourites) and app settings: the user's own, nobody else's
      match /places/{placeId} {
        allow read, write: if signedIn() && request.auth.uid == userId
          && (request.resource == null || request.resource.data.keys().hasOnly(['name', 'lat', 'lng', 'kind', 'updatedAt']));
      }
      match /settings/{docId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }
    match /routes/{routeId} {
      allow read, delete: if signedIn() && request.auth.uid == resource.data.userId;
      // Owners may edit their routes but not hand them to another account
      allow update: if signedIn() && request.auth.uid == resource.data.userId
        && request.resource.data.userId == resource.data.userId;
      allow create: if signedIn() && request.auth.uid == request.resource.data.userId;
    }
    match /signals/{signalId} {
      allow read: if signedIn();
      allow write: if signedIn() && roleOf(request.auth.uid) in ['supporter', 'controller', 'admin'];
    }
    match /overrides/{overrideId} {
      allow read: if signedIn();
      allow write: if signedIn() && roleOf(request.auth.uid) in ['controller', 'admin'];
    }
    // Everything else (server `commands`, `junctionCounts`, `signalControlLog`, `junctionRules`,
    // `tripRoutes`, `userFiles`, `adminLog`, `appSettings`) is Admin SDK only.
  }
}
